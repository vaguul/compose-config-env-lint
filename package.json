{
  "name": "compose-config-env-lint",
  "version": "0.1.2",
  "description": "CLI lint for Docker Compose configs.content values that accidentally interpolate runtime env variables.",
  "type": "module",
  "bin": {
    "compose-config-env-lint": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "validate": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "docker-compose",
    "compose",
    "coolify",
    "env",
    "lint",
    "self-hosted"
  ],
  "author": "Vaguul (Zemiax)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaguul/compose-config-env-lint.git"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
